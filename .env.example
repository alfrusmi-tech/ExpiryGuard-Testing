# Copy to .env and fill in real values. NEVER commit the real .env file.
POSTGRES_DB=expiryguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DB_URL=jdbc:postgresql://db:5432/expiryguard
DB_USERNAME=postgres
DB_PASSWORD=change_me
COOKIE_SECURE=false
EXPIRYGUARD_AUTO_APPROVE=false
# One-time admin bootstrap (remove after first start)
EXPIRYGUARD_BOOTSTRAP_USERNAME=admin
EXPIRYGUARD_BOOTSTRAP_EMAIL=admin@example.com
EXPIRYGUARD_BOOTSTRAP_PASSWORD=
